(defpoll clock_time :interval "1s"  :initial "" `date '+%H:%M:%S'`)
(defpoll clock_date :interval "60s" :initial "" `date '+%A, %d %B %Y'`)
(defpoll temp :interval "2s" :initial "--"
  `awk '{printf "%d°C", $1/1000}' /sys/class/thermal/thermal_zone0/temp 2>/dev/null`)
(defpoll wifi  :interval "5s"  :initial "…" "scripts/wifi.sh")
(defpoll vpnip :interval "10s" :initial ""  "scripts/tailscale.sh")
(deflisten workspaces :initial "[]" "scripts/workspaces.sh")

(defwidget pill [class icon text]
  (box :class "pill ${class}" :space-evenly false :spacing 6
    (label :class "icon" :text icon)
    (label :class "val"  :text text)))

(defwidget workspaces_w []
  (box :class "ws" :space-evenly false :spacing 2 :halign "start"
    (for w in workspaces
      (button :class {w.focused ? "ws-btn focused" : "ws-btn"}
              :onclick "i3-msg workspace number ${w.num}"
        "${w.num}"))))

(defwidget stats []
  (box :halign "end" :space-evenly false :spacing 0
    (pill :class "cpu"  :icon "󰻠" :text "${round(EWW_CPU.avg, 0)}%")
    (pill :class "mem"  :icon "󰍛" :text "${round(EWW_RAM.used_mem_perc, 0)}%")
    (pill :class "temp" :icon "󰔏" :text temp)
    (pill :class "disk" :icon "󰋊" :text "${round(EWW_DISK["/"].used_perc, 0)}%")
    (pill :class "wifi" :icon "󰖩" :text wifi)
    (box :visible {vpnip != ""} (pill :class "vpn" :icon "󰖂" :text vpnip))
    (pill :class "bat"  :icon "󰁹" :text "${round(EWW_BATTERY?.BAT0?.capacity ?: 0, 0)}%")))

(defwidget bar []
  (centerbox :class "bar"
    (box :halign "start"  :space-evenly false (workspaces_w))
    (box :halign "center" :space-evenly false
      (pill :class "clock" :icon "󰥔" :text "${clock_date}   ${clock_time}"))
    (stats)))

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :stacking "fg"
  :exclusive true
  :geometry (geometry :x "0"
                      :y "6px"
                      :width "99%"
                      :height "30px"
                      :anchor "top center")
  (bar))
